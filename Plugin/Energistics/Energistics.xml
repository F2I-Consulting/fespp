<ServerManagerConfiguration>

	<!-- ====================- Energistics (EPC/ETP) SOURCES -===================== -->
	<ProxyGroup name="sources">

		<!-- ================- - EPC Collector - -================================= -->
		<SourceProxy name="EPCCollector" class="vtkEPCCollector" label="EPCCollector">
			<Documentation short_help="Pipeline grouping epc files.">Pipeline grouping epc files.</Documentation>
			<Hints>
				<View type="RenderView" />
				<RepresentationType view="RenderView" type="Surface" />
				<PipelineIcon name="CINEMA_MARK" />
			</Hints>

			<!-- Files List loaded: -->
			<StringVectorProperty command="GetAllFiles" information_only="1" name="FilesInfo">
				<StringArrayHelper />
			</StringVectorProperty>
			<StringVectorProperty name="Files" command="SetFiles" number_of_elements="1" repeat_command="1" label="all files loaded" panel_visibility="never">
				<ArraySelectionDomain name="array_list" attribute_type="Scalars">
					<RequiredProperties>
						<Property function="FilesInfo" name="FilesInfo" />
					</RequiredProperties>
				</ArraySelectionDomain >
				<Documentation>List files loaded...</Documentation>
			</StringVectorProperty>

			<!-- TimeStepValues for Time series -->
			<DoubleVectorProperty information_only="1" name="TimestepValues" repeatable="1">
				<TimeStepsInformationHelper />
			</DoubleVectorProperty>

			<!-- treeView Selection -->
			<IntVectorProperty name="AssemblyTag" command="GetAssemblyTag" information_only="1">
				<Documentation> This is simply an int that changes whenever a new assembly is built by the reader. This can be used to determine if the assembly should be fetched from the reader whenever the reader is updated.</Documentation>
			</IntVectorProperty>
			<StringVectorProperty name="Selectors" command="AddSelector" clean_command="ClearSelectors" repeat_command="1" number_of_elements_per_command="1" panel_widget="data_assembly_editor">
				<DataAssemblyDomain name="data_assembly">
					<RequiredProperties>
						<Property function="Tag" name="AssemblyTag" />
					</RequiredProperties>
				</DataAssemblyDomain>
				<Documentation>  Specify the selectors for the data assembly chosen using **Assembly**  to choose the blocks to extract from the input dataset.</Documentation>
				<Hints>
					<!-- AssemblyTag == 0 implies there's no assembly in the file, in which case, we want to hide this widget entirely -->
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="AssemblyTag" value="0" inverse="1" />
					<WidgetHeight number_of_rows="500" />
				</Hints>
			</StringVectorProperty>

			<Property name="ApplyColors" command="ApplyColors" panel_widget="command_button"/>


			<!-- Extract Mode -->
			<!-- AssemblyTag == 0 implies there's no assembly in the file, in which case, we want to hide this widget entirely -->
			<IntVectorProperty name="ExtractTag" command="GetExtractTag" information_only="1">
			</IntVectorProperty>

			<!-- extractMode=1 shows DataSetListForCopy → ExtractWithoutCopy: a
			     SUB-SOURCE filter (EnergisticsExtractor in the "filters" group),
			     ShallowCopy in RequestData. The filter is chained on this
			     collector so it tracks upstream changes (selectors, realization
			     swap, property addDataArray) through the standard pipeline.
			     extractMode=2 shows DataSetList → ExtractWithCopy: a STANDALONE
			     snapshot (PVTrivialProducer in the "sources" group) holding a
			     one-shot DeepCopy. Detached from this collector's pipeline —
			     does NOT track upstream changes. Use for export / comparison.
			     The internal property names (DataSetList / DataSetListForCopy)
			     are kept as-is for backwards compatibility with saved state
			     files. -->
			<IntVectorProperty name="extractMode" number_of_elements="1" default_values="0" label="">
				<EnumerationDomain name="enum">
					<Entry text="Extract..." value="0" />
					<Entry text="Extract without copy" value="1" />
					<Entry text="Extract with copy" value="2" />
				</EnumerationDomain>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="ExtractTag" value="0"/>
				</Hints>
			</IntVectorProperty>

			<StringVectorProperty command="GetAllDataSet" information_only="1" name="DataSetInfo">
				<StringArrayHelper />
			</StringVectorProperty>
			<!-- DataSetList: shown when extractMode=2 ("Extract with copy"). Internal name kept for state-file backwards compat. -->
			<StringVectorProperty name="DataSetList" command="SetDataSetList" clean_command="ClearDataSetList" number_of_elements="2" repeat_command="1" number_of_elements_per_command="2" element_types="2 0" label="object to copy">
				<ArraySelectionDomain name="array_list">
					<RequiredProperties>
						<Property function="DataSetInfo" name="DataSetInfo" />
					</RequiredProperties>
				</ArraySelectionDomain>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="extractMode" value="2" />
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="ExtractTag" value="0"/>
					<WidgetHeight number_of_rows="20" />
				</Hints>
			</StringVectorProperty>

			<StringVectorProperty command="GetAllDataSetForCopy" information_only="1" name="DataSetInfoForCopy">
				<StringArrayHelper />
			</StringVectorProperty>
			<!-- DataSetListForCopy: shown when extractMode=1 ("Extract without copy"). Internal name kept for state-file backwards compat. -->
			<StringVectorProperty name="DataSetListForCopy" command="SetDataSetListForCopy" clean_command="ClearDataSetListForCopy" number_of_elements="2" repeat_command="1" number_of_elements_per_command="2" element_types="2 0" label="object to extract">
				<ArraySelectionDomain name="array_list">
					<RequiredProperties>
						<Property function="DataSetInfoForCopy" name="DataSetInfoForCopy" />
					</RequiredProperties>
				</ArraySelectionDomain>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="extractMode" value="1"/>
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="ExtractTag" value="0"/>
					<WidgetHeight number_of_rows="20" />
				</Hints>
			</StringVectorProperty>

			<!-- Programmatic per-rep extract used by fespp_on_trame.
			     Setting ExtractRepPath to a rep_path triggers SetExtractRepPath
			     in C++ which creates an EnergisticsExtractor filter chained on
			     this collector (registered in the "filters" group) and stores
			     the registration name. The filter does ShallowCopy in
			     RequestData, so upstream changes propagate naturally — no
			     explicit Modified() bump from Python is needed. The info-only
			     ExtractedRepProducerName property exposes the registration name
			     back to Python so it can resolve the proxy via the proxy
			     manager (filters group, fall back to sources for legacy).
			     panel_visibility="never" hides them from the GUI; they are
			     only meant to be driven programmatically. -->
			<StringVectorProperty name="ExtractRepPath" command="SetExtractRepPath"
				number_of_elements="1" panel_visibility="never">
			</StringVectorProperty>
			<StringVectorProperty name="ExtractedRepProducerName"
				command="GetExtractedRepProducerName" information_only="1"
				panel_visibility="never">
				<StringArrayHelper />
			</StringVectorProperty>

			<!-- ExplicitSelection: when 0 (default), a selector path implicitly
			     includes all descendants of the matched node — required for
			     ParaView GUI's data_assembly_editor widget which collapses
			     fully-selected subtrees to the parent path.
			     When 1, descendant inclusion is disabled for non-grouping
			     nodes (Representation, Property, Trajectory, ...) — the
			     selector is taken literally. Grouping nodes (Collection,
			     Wellbore, Partial) still propagate so that selecting a
			     Wellbore folder loads everything underneath.
			     panel_visibility="never": this is a programmatic flag toggled
			     by fespp_on_trame at boot, not a user-facing setting. -->
			<IntVectorProperty name="ExplicitSelection"
				command="SetExplicitSelection"
				number_of_elements="1"
				default_values="0"
				panel_visibility="never">
				<BooleanDomain name="bool" />
			</IntVectorProperty>

			<!-- TreeHierarchyMode: layout of the data assembly tree.
			     0 = Flat (default, legacy behavior).
			     1 = ByInterpretation (reps grouped under their Interpretation).
			     2 = ByFeatureAndInterpretation (reps grouped under Feature → Interpretation).
			     Visible in ParaView's property panel so a user can switch
			     layouts without going through fespp_on_trame; switching
			     triggers a live rebuild of the assembly via SetTreeHierarchyMode
			     → repository.rebuildAssembly(). -->
			<IntVectorProperty name="TreeHierarchyMode"
				label="Tree Hierarchy"
				command="SetTreeHierarchyMode"
				number_of_elements="1"
				default_values="0">
				<EnumerationDomain name="enum">
					<Entry value="0" text="Flat" />
					<Entry value="1" text="By Interpretation" />
					<Entry value="2" text="By Feature and Interpretation" />
				</EnumerationDomain>
				<Documentation>
					Layout of the data assembly tree. Flat keeps the
					legacy behavior (representations directly under the
					root). By Interpretation groups representations under
					their Interpretation parent. By Feature and
					Interpretation adds an extra Feature grouping above
					the Interpretation. Switching rebuilds the assembly
					in place from the already-loaded fesapi repository.
				</Documentation>
			</IntVectorProperty>

			<!-- Wellbore marker properties: -->
			<!-- enable/disable Marker orientation -->
			<IntVectorProperty name="MarkerOrientation" command="setMarkerOrientation" number_of_elements="1" default_values="1">
				<BooleanDomain name="bool" />
			</IntVectorProperty>
			<!-- marker size -->
			<IntVectorProperty name="MarkerSize" command="setMarkerSize" number_of_elements="1" default_values="10"></IntVectorProperty>

			<PropertyGroup label="Wellbore marker">
				<Property name="MarkerOrientation" />
				<Property name="MarkerSize" />
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="Options" value="0"/>
				</Hints>
			</PropertyGroup>

			<!-- Multi-realization selection is driven directly by the data
			     assembly tree: each MR / MR+TS parent node carries one
			     child per realization index (type=Properties for MR,
			     type=TimeSeries for MR+TS), toggled via the standard
			     BlockSelectors widget. Checking the parent propagates to
			     all realizations; checking individual children loads a
			     subset. -->
		</SourceProxy>

		<!-- ================- - EPC READER - -==================================== -->
		<SourceProxy name="EPCReader" class="vtkEPCReader" label="Energistics Packaging Conventions (EPC) Reader">
			<Documentation short_help="A reader for an Energistics standard data format used by	various geosciences applications.">A reader for an Energistics standard data format used by	various geosciences applications. The underlying format uses OPC to store XML documents and links to an HDF5 file which stores the numerical data arrays into HDF5 datasets.</Documentation>
			<Hints>
				<ReaderFactory extensions="epc" file_description="EPC files" filename_patterns="*.epc" />
				<RepresentationType view="RenderView" type="Wireframe" />
				<PipelineIcon name="CINEMA_MARK" />
			</Hints>

			<!-- File to load: -->
			<StringVectorProperty clean_command="ClearFileName" command="AddFileNameToFiles" name="FileName" number_of_elements="1" repeat_command="1" label="add file">
				<FileListDomain name="files" />
				<Documentation>This property specifies the file name for the epc reader.</Documentation>
				<Hints>
					<FileChooser extensions="epc" file_description="epc file to load" />
				</Hints>
			</StringVectorProperty>
		</SourceProxy>

		<!-- ================- - ETP CONNECT - -=================================== -->
		<SourceProxy name="ETPsource" class="vtkETPSource" label="ETP1.2 Store">
			<Documentation short_help="A reader for an Energistics standard data format used by	various geosciences applications.">A reader for an Energistics standard data format used by	various geosciences applications. The underlying format uses OPC to store XML documents and links to an HDF5 file which stores the numerical data arrays into HDF5 datasets.</Documentation>
			<Hints>
				<PipelineIcon name="SECURE_SERVER" />
			</Hints>

			<!-- properties for connection to server -->
			<!-- tag for hide/enabled properties -->
			<IntVectorProperty name="ConnectionTag" command="GetConnectionTag" information_only="1"></IntVectorProperty>
			<IntVectorProperty name="DisconnectionTag" command="GetDisconnectionTag" information_only="1"></IntVectorProperty>

			<!-- URLs definitions -->
			<StringVectorProperty command="setETPUrlConnection" default_values="wss://api.awsinterop.adopt.paas.47lining.com/api/reservoir-ddms-etp/v2" name="ETPUrl" label="ETP Url" number_of_elements="1" panel_visibility="default">
				<Documentation>This property specifies the string used to describe the ETP Url</Documentation>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="enabled_state" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</StringVectorProperty>

			<StringVectorProperty command="setProxyUrlConnection" default_values="" name="ProxyUrl" label="Proxy Url" number_of_elements="1" panel_visibility="default">
				<Documentation>This property specifies the string used to describe the PROXY Url</Documentation>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="enabled_state" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</StringVectorProperty>

			<!-- data partition definition -->
			<StringVectorProperty name="OSDUDataPartition" command="setOSDUDataPartition" number_of_elements="1" default_values="osdu">
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="enabled_state" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</StringVectorProperty>

			<!-- authentifications definitions -->
			<!-- types -->
			<IntVectorProperty name="ETPTokenType" command="setETPTokenType" number_of_elements="1" default_values="0">
				<EnumerationDomain name="enum">
					<Entry value="0" text="Bearer"/>
					<Entry value="1" text="Basic"/>
				</EnumerationDomain>
				<Documentation> This property indicates which authentification type mode will be used.</Documentation>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="enabled_state" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</IntVectorProperty>

			<IntVectorProperty name="ProxyTokenType" command="setProxyTokenType" number_of_elements="1" default_values="1">
				<EnumerationDomain name="enum">
					<Entry value="0" text="Bearer"/>
					<Entry value="1" text="Basic"/>
				</EnumerationDomain>
				<Documentation> This property indicates which authentification type mode will be used.</Documentation>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="enabled_state" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</IntVectorProperty>
			<!-- pwd -->
			<StringVectorProperty command="setETPToken" default_values="" name="ETPToken" number_of_elements="1" panel_visibility="default">
				<Documentation>This property specifies the string used to describe the authorization.</Documentation>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="enabled_state" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</StringVectorProperty>

			<StringVectorProperty command="setProxyToken" default_values="" name="ProxyToken" number_of_elements="1" panel_visibility="default">
				<Documentation>This property specifies the string used to describe the authorization.</Documentation>
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="enabled_state" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</StringVectorProperty>

			<!-- action -->
			<Property name="Connect" command="confirmConnectionClicked">
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="ConnectionTag" value="0" inverse="1" />
				</Hints>
			</Property>
			<Property name="Disconnect" command="disconnectionClicked">
				<Hints>
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="DisconnectionTag" value="0" inverse="1" />
				</Hints>
			</Property>

			<PropertyGroup label="ETP Connection">
				<Property name="ETPUrl" />
				<Property name="OSDUDataPartition" />
				<Property name="ETPTokenType" />
				<Property name="ETPToken" />
			</PropertyGroup>
			<PropertyGroup label="Proxy Connection">
				<Property name="ProxyUrl" />
				<Property name="ProxyTokenType" />
				<Property name="ProxyToken" />
			</PropertyGroup>
			<PropertyGroup label="Connection">
				<Property name="Connect" />
				<Property name="Disconnect" />
			</PropertyGroup>

			<!-- property to choose dataspace -->
			<StringVectorProperty command="GetAllDataspaces" information_only="1" name="DataspacesInfo">
				<StringArrayHelper />
			</StringVectorProperty>
			<StringVectorProperty name="Dataspaces" command="SetDataspaces" number_of_elements="1" animateable="0">
				<StringListDomain name="array_list">
					<RequiredProperties>
						<Property name="DataspacesInfo" function="ArrayList" />
					</RequiredProperties>
				</StringListDomain >
			</StringVectorProperty>

			<!-- New properties for accessing dataspaces from Python -->
			<IntVectorProperty command="GetNumberOfDataspaces" information_only="1" name="NumberOfDataspaces">
				<Documentation>Returns the number of available dataspaces.</Documentation>
			</IntVectorProperty>

			<!-- Property to get all dataspace names as a string array -->
			<StringVectorProperty command="GetAllDataspaces"
			                      information_only="1"
			                      name="AllDataspaceNames">
				<StringArrayHelper />
				<Documentation>Returns all available dataspace names from the AllDataspaces vtkStringArray.</Documentation>
			</StringVectorProperty>

			<!-- TimeStepValues for Time series -->
			<DoubleVectorProperty information_only="1" name="TimestepValues" repeatable="1">
				<TimeStepsInformationHelper />
			</DoubleVectorProperty>


			<!-- treeView Selection -->
			<IntVectorProperty name="AssemblyTag" command="GetAssemblyTag" information_only="1">
				<Documentation> This is simply an int that changes whenever a new assembly is built by the reader. This can be used to determine if the assembly should be fetched from the reader whenever the reader is updated.</Documentation>
			</IntVectorProperty>
			<StringVectorProperty name="Selectors" command="AddSelector" clean_command="ClearSelectors" repeat_command="1" number_of_elements_per_command="1" panel_widget="data_assembly_editor">
				<DataAssemblyDomain name="data_assembly">
					<RequiredProperties>
						<Property function="Tag" name="AssemblyTag" />
					</RequiredProperties>
				</DataAssemblyDomain>
				<Documentation>  Specify the selectors for the data assembly chosen using **Assembly**  to choose the blocks to extract from the input dataset.</Documentation>
				<Hints>
					<!-- AssemblyTag == 0 implies there's no assembly in the file, in which case, we want to hide this widget entirely -->
					<PropertyWidgetDecorator type="GenericDecorator" mode="visibility" property="AssemblyTag" value="0" inverse="1" />
				</Hints>
			</StringVectorProperty>


			<!-- Wellbore marker properties: -->
			<!-- enable/disable Marker orientation -->
			<IntVectorProperty name="MarkerOrientation" command="setMarkerOrientation" number_of_elements="1" default_values="1">
				<BooleanDomain name="bool" />
			</IntVectorProperty>
			<!-- marker size -->
			<IntVectorProperty name="MarkerSize" command="setMarkerSize" number_of_elements="1" default_values="10">
			</IntVectorProperty>
			<PropertyGroup label="Wellbore marker">
				<Property name="MarkerOrientation" />
				<Property name="MarkerSize" />
			</PropertyGroup>
		</SourceProxy>
	</ProxyGroup>

	<!-- ====================- EPC/ETP FILTER -==================================== -->
	<ProxyGroup name="filters">

		<!-- ================- - Extractor block - -=============================== -->
		<SourceProxy name="EnergisticsExtractor" class="vtkEnergisticsExtractor" label="Extract Energistics block">
			<Documentation long_help="Extract Energistics block">
			</Documentation>

			<InputProperty command="SetInputConnection" name="Input">
				<ProxyGroupDomain name="groups">
					<Group name="sources" />
					<Group name="filters" />
				</ProxyGroupDomain>
				<DataTypeDomain name="input_type">
					<DataType value="vtkPartitionedDataSetCollection" />
				</DataTypeDomain>
				<Documentation>The input from which the selection is extracted.</Documentation>
			</InputProperty>

			<StringVectorProperty name="ExtractPath" command="SetExtractPath" number_of_elements="1" default_values="1" panel_visibility="never">
				<Documentation>
    assembly path to extract.
				</Documentation>
			</StringVectorProperty>

			<!-- View can be used to specify the preferred view for the proxy -->
			<Hints>
				<Visibility replace_input="1" />
				<PipelineIcon name=":/pqWidgets/Icons/pqExtractSelection.svg" />
			</Hints>

		</SourceProxy>

		<!-- ================- - Clone of an EPCCollector output - -============== -->
		<!-- Pass-through filter that ShallowCopy's an upstream             -->
		<!-- vtkPartitionedDataSetCollection (data + assembly). The         -->
		<!-- plugin makes no assumption about how callers use it; in        -->
		<!-- fespp_on_trame each render view holds one clone so its         -->
		<!-- per-view sub-pipeline (slice / clip / etc.) chains off a      -->
		<!-- view-local proxy instead of the shared EPCCollector. Memory:   -->
		<!-- ShallowCopy keeps buffers shared — N clones cost N proxies,    -->
		<!-- not N×data.                                                    -->
		<SourceProxy name="EPCCollectorClone" class="vtkEPCCollectorClone" label="EPC collector clone">
			<Documentation long_help="ShallowCopy passthrough of an EPCCollector output.">
			</Documentation>

			<InputProperty command="SetInputConnection" name="Input">
				<ProxyGroupDomain name="groups">
					<Group name="sources" />
					<Group name="filters" />
				</ProxyGroupDomain>
				<DataTypeDomain name="input_type">
					<DataType value="vtkPartitionedDataSetCollection" />
				</DataTypeDomain>
				<Documentation>The EPCCollector source (or another vtkPartitionedDataSetCollection-producing filter) this clone passes through.</Documentation>
			</InputProperty>

			<Hints>
				<Visibility replace_input="0" />
			</Hints>
		</SourceProxy>
	</ProxyGroup>

	<!-- ====================- EPC/ETP WRITER -==================================== -->
	<ProxyGroup name="writers">
		<WriterProxy name="EPCWriter" class="vtkEPCWriter" base_proxygroup="writers">
			<Documentation short_help="A reader for an Energistics standard data format used by	various geosciences applications.">A reader for an Energistics standard data format used by	various geosciences applications. The underlying format uses OPC to store XML documents and links to an HDF5 file which stores the numerical data arrays into HDF5 datasets.</Documentation>

			<InputProperty name="Input" command="SetInputConnection">
				<ProxyGroupDomain name="groups">
					<Group name="sources"/>
					<Group name="filters"/>
				</ProxyGroupDomain>
				<DataTypeDomain name="input_type" composite_data_supported="1">
					<DataType value="vtkUnstructuredGrid"/>
					<DataType value="vtkPartitionedDataSetCollection"/>
				</DataTypeDomain>
			</InputProperty>

			<StringVectorProperty name="FileName" command="SetFileName" number_of_elements="1">
				<FileListDomain name="files"/>
				<Documentation>The name of the file to be written.</Documentation>
			</StringVectorProperty>
			<Hints>
				<Property name="Input" show="0"/>
				<Property name="FileName" show="0"/>
				<WriterFactory extensions="epc" file_description="epc file format"/>
			</Hints>
		</WriterProxy>
	</ProxyGroup>
	<!-- End Reader -->
</ServerManagerConfiguration>